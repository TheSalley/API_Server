# HTTP 服务
PORT=3501
HOST=0.0.0.0

# CORS：* 表示允许所有来源，也可配置为逗号分隔的域名列表
CORS_ORIGINS=*

# 调试面板（生产环境可设为 false）
PANEL_ENABLED=true

# SQLite 数据库文件（默认 src/data/app.db）
# DB_FILE=/absolute/path/to/app.db

# 图片上传（默认 src/data/uploads，URL 前缀 /uploads）
# UPLOAD_DIR=/absolute/path/to/uploads
# UPLOAD_URL_PREFIX=/uploads
# 默认 20MB，单位：字节
# MAX_UPLOAD_SIZE=20971520
# 默认不开放 SVG（SVG 可能携带脚本）；确需开放时请额外做内容清洗
# ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp,bmp,avif

# 预设文案语言：仅英文（如需扩展，追加逗号分隔的语言代码）
DEFAULT_LANG=en
SUPPORTED_LANGS=en

# ImageBase 公开素材接口（分组与图片同步）
# IMAGEBASE_API_BASE_URL=https://imagebase.yhct.site/wp-json/public-cropper/v1
